# Copie ce fichier en .env puis renseigne ta clé (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modèle utilisé par le bot analyste (léger par défaut pour limiter le coût)
ANTHROPIC_MODEL=claude-haiku-5-5
# Dossier de sortie de ton scraper Cote_scrapper
BRVM_SCRAP_DIR=~/BRVM_DATA_SCRAP
# Rafraîchissement des bots (minutes)
QUOTE_REFRESH_MINUTES=5
NEWS_REFRESH_MINUTES=60
